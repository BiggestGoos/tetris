cabal-version:      3.0
name:               tetris
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             BiggestGoos
maintainer:         gustav@fagerlind.net
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Tetris
    other-modules:
      Data.Position
      Data.Square
      Data.Tetromino
      Data.Tetromino.Type
      Data.Player
      Game
    -- other-extensions:
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   lib
    default-language: GHC2024

executable tetris
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.20.2.0,
        tetris

    hs-source-dirs:   app
    default-language: GHC2024
